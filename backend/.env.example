DATABASE_URL="postgresql://postgres:password@localhost:5432/mtbrescue?schema=public"
PORT=3000
NODE_ENV=development
OTEL_SERVICE_NAME=mtb-rescue-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.version=0.0.1,deployment.environment.name=development
OTEL_METRIC_EXPORT_INTERVAL=60000
# Set to true only when telemetry must be disabled explicitly.
OTEL_SDK_DISABLED=false
